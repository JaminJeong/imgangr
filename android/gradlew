#!/bin/sh
#
# Gradle 시작 스크립트 (Unix)
#

# OS 감지
darwin=false
case "$(uname)" in
  Darwin* ) darwin=true;;
esac

# JAVA_HOME이 지정되어 있으면 사용
if [ -n "$JAVA_HOME" ] ; then
    JAVACMD="$JAVA_HOME/bin/java"
    if [ ! -f "$JAVACMD" ] ; then
        die "JAVA_HOME이 유효하지 않습니다: $JAVA_HOME"
    fi
else
    JAVACMD="java"
    which java >/dev/null 2>&1 || die "java 명령을 찾을 수 없습니다. JAVA_HOME을 설정하거나 java를 PATH에 추가하세요."
fi

# Gradle Wrapper 메인 클래스 실행
exec "$JAVACMD" \
  -classpath "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" \
  org.gradle.wrapper.GradleWrapperMain "$@"
